# Discord (required)
DISCORD_TOKEN=

# Required only for slash command registration scripts
DISCORD_CLIENT_ID=

# Optional: set during development for instant guild-scoped slash commands
DISCORD_GUILD_ID=

# Optional first-run defaults. Runtime configuration is persisted in data.json.
DISCORD_NOTIFY_CHANNEL_ID=
PREFIX=.
MENTION_HERE=true
KEYWORD_REGEX=nox\s*rp
CHECK_INTERVAL_SECONDS=300
ENV_OVERRIDES_DB=false

# Optional authorization. Leave blank to fall back to Discord Manage Server permission.
ALLOWED_ROLE_IDS=

# Optional streamer live role. Bot needs Manage Roles and the target role must be below the bot role.
STREAMER_LIVE_ROLE_ID=

# Optional discovery mode
DISCOVERY_MODE=false
DISCOVERY_TWITCH_PAGES=5
DISCOVERY_KICK_LIMIT=100

# Twitch (optional; both ID and secret are needed to enable Twitch monitoring)
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_GTA5_GAME_ID=32982

# Kick (optional; both ID and secret are needed to enable Kick monitoring)
KICK_CLIENT_ID=
KICK_CLIENT_SECRET=
KICK_GTA_CATEGORY_NAME=Grand Theft Auto V

# Persistence (optional)
# Prefer an absolute path in production. DATA_FILE overrides DATA_DIR.
DATA_DIR=
DATA_FILE=

# FiveM, Tickets, Welcome and anti-raid settings are configured through slash commands
# and persisted in data.json. They intentionally do not use undocumented ENV overrides.
