{
  "name": "fivem-discord-manager-bot",
  "version": "2.1.0",
  "description": "Modular Discord bot for FiveM communities: stream alerts (Twitch/Kick), live server status with voice channel display, ticket system, welcome with anti-raid, goodbye messages, and server stats.",
  "main": "src/index.js",
  "type": "commonjs",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "slash:register": "node src/modules/stream-notifier/slash/register.js",
    "slash:list": "node src/modules/stream-notifier/slash/list-commands.js",
    "slash:purge": "node src/modules/stream-notifier/slash/purge-commands.js"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "axios": "^1.7.9",
    "discord.js": "^14.16.3",
    "dotenv": "^16.4.7"
  },
  "license": "MIT",
  "keywords": [
    "discord",
    "discord-bot",
    "discord.js",
    "twitch",
    "kick",
    "gta-v",
    "gtav",
    "roleplay",
    "rp",
    "stream-notifier",
    "oauth2"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/power0matin/fivem-discord-manager-bot.git"
  },
  "bugs": {
    "url": "https://github.com/power0matin/fivem-discord-manager-bot/issues"
  },
  "homepage": "https://github.com/power0matin/fivem-discord-manager-bot#readme"
}
